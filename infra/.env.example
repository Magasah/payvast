# Copy to infra/.env and change every value marked CHANGE_ME.
# Never commit infra/.env.

# --- PostgreSQL ---
POSTGRES_USER=payvast
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=payvast

# --- API ---
ENV=dev
# Inside docker-compose the host is "db".
DATABASE_URL=postgresql+asyncpg://payvast:CHANGE_ME_db_password@db:5432/payvast
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_string_here
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Browsers accept Secure cookies on http://localhost, so keep true.
COOKIE_SECURE=true

# VPN panel adapter: mock | 3xui (3xui is implemented in stage 2)
PANEL_ADAPTER=mock
THREEXUI_BASE_URL=
THREEXUI_USERNAME=
THREEXUI_PASSWORD=

# --- Admin ---
# The ONLY way to be admin: sign in through Telegram with an id from this list.
# Comma-separated numeric Telegram user ids. Nothing in the code or DB can grant admin otherwise.
ADMIN_TELEGRAM_IDS=CHANGE_ME_your_telegram_id

# --- Payment requisites shown to users (a method is hidden while its account is empty) ---
PAYMENT_ALIF_ACCOUNT=+992XXXXXXXXX
PAYMENT_ALIF_RECIPIENT=CHANGE_ME
PAYMENT_DC_ACCOUNT=+992XXXXXXXXX
PAYMENT_DC_RECIPIENT=CHANGE_ME
PAYMENT_DC_FEE_PERCENT=1
# Card number as it should be shown, e.g. "5413 0000 0000 0000"
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_RECIPIENT=CHANGE_ME

# Account lockout after wrong passwords in a row (per account, on top of per-IP limits)
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15

UPLOAD_DIR=/data/uploads
RECEIPT_MAX_BYTES=5242880

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_PAYMENT=10/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_TELEGRAM=10/minute

# --- Web ---
# Where the Next.js server proxies /api/* (internal docker network).
API_INTERNAL_URL=http://api:8000

# --- Telegram (API + bot) ---
# From @BotFather. The API uses it to verify Mini App sign-in and to send notifications.
TELEGRAM_BOT_TOKEN=
# Max age of Telegram sign-in data, seconds
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Shared secret between bot and API. Generate like JWT_SECRET.
BOT_API_SECRET=CHANGE_ME_long_random_string
# Public https address of the site: Mini App button in the bot and links in notifications.
WEB_APP_URL=https://example.com
# Where the bot reaches the API (internal docker network)
API_URL=http://api:8000
