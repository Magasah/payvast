# Copy to infra/.env and change every value marked CHANGE_ME.
# Never commit infra/.env.

# --- PostgreSQL ---
POSTGRES_USER=payvast
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=payvast

# --- API ---
ENV=dev
# Inside docker-compose the host is "db".
DATABASE_URL=postgresql+asyncpg://payvast:CHANGE_ME_db_password@db:5432/payvast
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_at_least_32_chars_random_string_here
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Browsers accept Secure cookies on http://localhost, so keep true.
COOKIE_SECURE=true

# VPN panel adapter: mock | 3xui (3xui is implemented in stage 2)
PANEL_ADAPTER=mock
THREEXUI_BASE_URL=
THREEXUI_USERNAME=
THREEXUI_PASSWORD=

# Wallet details shown to users for manual payment
PAYMENT_WALLET_ALIF=CHANGE_ME_alif_number
PAYMENT_WALLET_DC=CHANGE_ME_dushanbe_city_number

UPLOAD_DIR=/data/uploads
RECEIPT_MAX_BYTES=5242880

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_PAYMENT=10/minute
RATE_LIMIT_REFRESH=30/minute

# --- Web ---
# Where the Next.js server proxies /api/* (internal docker network).
API_INTERNAL_URL=http://api:8000

# --- Telegram bot (stub) ---
TELEGRAM_BOT_TOKEN=
